---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<Layout title="Blog — Jake Nocentino" description="Writing about software engineering, technology, and life.">
  <Nav />
  <main class="max-w-5xl mx-auto px-6 pt-32 pb-24">
    <div class="mb-12">
      <p class="font-mono text-indigo-400 text-sm mb-2">thoughts &amp; notes</p>
      <h1 class="text-4xl font-bold text-zinc-50">Blog</h1>
    </div>

    {
      posts.length === 0 ? (
        <p class="text-zinc-500">No posts yet — check back soon.</p>
      ) : (
        <div class="space-y-4">
          {posts.map(post => (
            <a
              href={`/blog/${post.slug}`}
              class="group flex flex-col sm:flex-row sm:items-center justify-between border border-zinc-800 rounded-lg p-5 hover:border-indigo-400/40 transition-colors bg-zinc-900/40"
            >
              <div>
                <h2 class="text-zinc-100 font-medium group-hover:text-indigo-400 transition-colors mb-1">
                  {post.data.title}
                </h2>
                {post.data.description && (
                  <p class="text-zinc-500 text-sm">{post.data.description}</p>
                )}
                {post.data.categories && (
                  <div class="flex flex-wrap gap-2 mt-2">
                    {post.data.categories.map((cat: string) => (
                      <span class="font-mono text-xs text-zinc-600 bg-zinc-800 px-2 py-0.5 rounded">
                        {cat}
                      </span>
                    ))}
                  </div>
                )}
              </div>
              <p class="font-mono text-zinc-600 text-xs mt-2 sm:mt-0 sm:ml-8 shrink-0">
                {formatDate(post.data.date)}
              </p>
            </a>
          ))}
        </div>
      )
    }
  </main>
  <Footer />
</Layout>
