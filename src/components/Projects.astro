---
const projects = [
  {
    name: 'tinymesh0',
    description:
      'tinymesh0 is a cryptographically secure, decentralized mesh WireGuard VPN with gossip-based node discovery and per-node access policy enforcement. tinymesh0 connects machines across the internet into a private encrypted network with fastness, leanness, and security all placed at the forefront.',
    tech: ['Go', 'Networking', 'Docker', 'd3js', 'Cryptography'],
    github: 'https://github.com/jakenoc/tinymesh0',
  },
  {
    name: 'Golang Web Crawler',
    description:
      'A concurrent web crawler built in Go, deployed on Kubernetes via Kind. Explores Go concurrency patterns, channel-based communication, and containerized deployment.',
    tech: ['Go', 'Kubernetes', 'Docker', 'Kind'],
    github: 'https://github.com/jakenoc',
    live: null,
    wip: true,
  },
  {
    name: 'nocentino.dev',
    description:
      'This personal website — built with Astro and Tailwind CSS, deployed to GitHub Pages via GitHub Actions. A fast, minimal, statically-generated site.',
    tech: ['Astro', 'Tailwind CSS', 'TypeScript', 'GitHub Actions'],
    github: 'https://github.com/jakenoc/JakeNocentino.github.io',
    live: 'https://nocentino.dev',
    wip: false,
  },
];
---

<section id="projects" class="py-24">
  <div class="max-w-5xl mx-auto px-6">
    <div class="flex items-center gap-4 mb-12">
      <span class="font-mono text-indigo-400 text-sm">03.</span>
      <h2 class="text-2xl font-bold text-zinc-50">Projects</h2>
      <div class="flex-1 h-px bg-zinc-800 max-w-xs"></div>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {
        projects.map(project => (
          <div class="group flex flex-col border border-zinc-800 rounded-lg p-6 hover:border-indigo-400/40 transition-colors bg-zinc-900/40">
            <div class="flex items-start justify-between mb-3">
              <svg
                class="w-8 h-8 text-indigo-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
                />
              </svg>
              <div class="flex gap-3">
                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-zinc-500 hover:text-zinc-50 transition-colors"
                    aria-label="GitHub"
                  >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                    </svg>
                  </a>
                )}
                {project.live && (
                  <a
                    href={project.live}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-zinc-500 hover:text-zinc-50 transition-colors"
                    aria-label="Live site"
                  >
                    <svg
                      class="w-5 h-5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                      />
                    </svg>
                  </a>
                )}
              </div>
            </div>

            <h3 class="text-zinc-50 font-semibold mb-2 group-hover:text-indigo-400 transition-colors">
              {project.name}
              {project.wip && (
                <span class="ml-2 text-xs font-mono text-amber-400 bg-amber-400/10 px-1.5 py-0.5 rounded">
                  WIP
                </span>
              )}
            </h3>
            <p class="text-zinc-400 text-sm leading-relaxed flex-1 mb-4">
              {project.description}
            </p>
            <div class="flex flex-wrap gap-2">
              {project.tech.map(t => (
                <span class="font-mono text-xs text-indigo-400 bg-indigo-400/10 px-2 py-1 rounded">
                  {t}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
