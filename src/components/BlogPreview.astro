---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<section id="blog" class="py-24 bg-zinc-900/30">
  <div class="max-w-5xl mx-auto px-6">
    <div class="flex items-center gap-4 mb-12">
      <span class="font-mono text-indigo-400 text-sm">04.</span>
      <h2 class="text-2xl font-bold text-zinc-50">Blog</h2>
      <div class="flex-1 h-px bg-zinc-800 max-w-xs"></div>
    </div>

    {
      posts.length === 0 ? (
        <p class="text-zinc-500">No posts yet — stay tuned.</p>
      ) : (
        <div class="space-y-4">
          {posts.map(post => (
            <a
              href={`/blog/${post.slug}`}
              class="group flex flex-col sm:flex-row sm:items-center justify-between border border-zinc-800 rounded-lg p-5 hover:border-indigo-400/40 transition-colors bg-zinc-900/40"
            >
              <div>
                <h3 class="text-zinc-100 font-medium group-hover:text-indigo-400 transition-colors mb-1">
                  {post.data.title}
                </h3>
                {post.data.description && (
                  <p class="text-zinc-500 text-sm">{post.data.description}</p>
                )}
              </div>
              <p class="font-mono text-zinc-600 text-xs mt-2 sm:mt-0 sm:ml-6 shrink-0">
                {formatDate(post.data.date)}
              </p>
            </a>
          ))}
        </div>
      )
    }

    <div class="mt-8 text-center">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 font-mono text-sm text-indigo-400 hover:text-indigo-300 transition-colors"
      >
        View all posts
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
